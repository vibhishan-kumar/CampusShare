PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# PostgreSQL Connection (Optional: if empty or unreachable, falls back to embedded dev DB automatically)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=campusshare_db
PGPASSWORD=your_postgres_password
PGPORT=5432
# Or full connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/campusshare_db

# Real Email Delivery (SMTP - Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_FROM="CampusShare UoH" <your_email@gmail.com>

# Online Payment Gateway (Razorpay - Optional)
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_secret_key

# Cloud Media Storage (Cloudinary - Optional, falls back to local /uploads if not set)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

